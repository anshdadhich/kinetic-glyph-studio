// ============================================================================
// 5. RENDER ENGINE (By Style OR Compare Icon) + SEARCH + COPY
// ============================================================================
const showcase = document.getElementById("showcase");
const toast = document.getElementById("toast");
let toastTimer;
function triggerIcon(name, btn, svg) {
  if (CHOREO[name]) CHOREO[name](svg);
  triggerSound(name, btn);
}
function makeButton(icon, style) {
  const btn = document.createElement("button");
  btn.className = "icon-btn";
  btn.title = `${icon.name} — ${style.label}`;
  btn.setAttribute("aria-label", `${icon.name} ${style.label}`);
  btn.innerHTML = `<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">${icon[style.id]}</svg>`;
  const svg = btn.querySelector("svg");
  btn.addEventListener("pointerenter", () => {
    if (clickMode === "play") triggerIcon(icon.name, btn, svg);
  });
  btn.addEventListener("click", () => {
    initAudio();
    if (clickMode === "copy") copyStandaloneSvg(svg, style.id);
    else triggerIcon(icon.name, btn, svg);
  });
  return btn;
}
function render() {
  const q = document.getElementById("search").value.trim().toLowerCase();
  const filtered = ICONS.filter((ic) => ic.name.includes(q));
  showcase.innerHTML = "";
  if (viewMode === "style") {
    STYLES.forEach((style) => {
      const panel = document.createElement("section");
      panel.className = "panel";
      panel.innerHTML = `<div class="panel-header"><h2 class="panel-title">${style.label}</h2><p class="panel-rule">${style.rule}</p></div><div class="icon-grid"></div>`;
      const grid = panel.querySelector(".icon-grid");
      filtered.forEach((icon) => grid.appendChild(makeButton(icon, style)));
      showcase.appendChild(panel);
    });
  } else {
    filtered.forEach((icon) => {
      const panel = document.createElement("section");
      panel.className = "panel";
      panel.innerHTML = `<div class="panel-header"><h2 class="panel-title">${icon.name}</h2><p class="panel-rule">All 10 styles side-by-side</p></div><div class="icon-grid"></div>`;
      const grid = panel.querySelector(".icon-grid");
      STYLES.forEach((style) => grid.appendChild(makeButton(icon, style)));
      showcase.appendChild(panel);
    });
  }
}
function copyStandaloneSvg(svgEl, styleId) {
  const clone = svgEl.cloneNode(true);
  clone.querySelectorAll("[data-part]").forEach((el) => el.removeAttribute("style"));
  let inner = clone.innerHTML.trim();
  if (styleId === "glass" || styleId === "hardware") {
    inner = document.getElementById("master-defs").outerHTML + "\n" + inner;
  }
  const code = `<svg viewBox="0 0 24 24" width="24" height="24" xmlns="http://www.w3.org/2000/svg">\n${inner}\n</svg>`;
  navigator.clipboard.writeText(code).then(() => {
    toast.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove("show"), 1500);
  });
}
function setView(mode) {
  viewMode = mode;
  document.getElementById("viewStyle").classList.toggle("active", mode === "style");
  document.getElementById("viewIcon").classList.toggle("active", mode === "icon");
  render();
}
function setMode(mode) {
  clickMode = mode;
  document.getElementById("modePlay").classList.toggle("active", mode === "play");
  document.getElementById("modeCopy").classList.toggle("active", mode === "copy");
}
function setTheme(theme, el) {
  document.documentElement.setAttribute("data-theme", theme);
  el.parentElement.querySelectorAll(".btn").forEach((b) => b.classList.remove("active"));
  el.classList.add("active");
}
render();
</script>
